# J. Austin Front Desk Processing - Environment Variables

# Django
FRONTDESK_SECRET_KEY=change-me-to-a-random-string
FRONTDESK_DEBUG=False
FRONTDESK_ALLOWED_HOSTS=agent.opentruthai.com,localhost,127.0.0.1

# Database
FRONTDESK_DB_NAME=frontdesk
FRONTDESK_DB_USER=frontdesk
FRONTDESK_DB_PASSWORD=frontdesk_secret
FRONTDESK_DB_HOST=frontdesk-db
FRONTDESK_DB_PORT=5432

# Redis (Celery broker)
FRONTDESK_REDIS_URL=redis://frontdesk-redis:6379/1

# SendGrid (for email/SMS)
SENDGRID_API_KEY=

# Twilio (for SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# AI APIs
ANTHROPIC_API_KEY=
GROK_API_KEY=

# Front Desk AI
FRONTDESK_AI_API_KEY=
